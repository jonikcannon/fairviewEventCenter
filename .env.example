# Copy this file to `.env` and fill in every value you need for the features
# you're using. `.env` is gitignored -- never commit real secrets.
#
# Every var here is read via `require('dotenv').config()` in fairviewApi/server.js
# and the scripts/ CLI tools. Nothing in this file is read by the Angular
# frontend directly (the frontend has no build-time env injection); the only
# frontend-facing values are MEDIA_CDN_URL and API_BASE_URL, which get baked
# into src/assets/media-config.json by `npm run manifest` (see below).

# ---- Server -----------------------------------------------------------
# Port the Express API listens on.
PORT=3500
# Host the API binds to. Keep this at 127.0.0.1 in production -- nginx
# proxies to it locally; binding 0.0.0.0 would expose it directly on the LAN
# and let requests bypass the rate limiters in front of it.
BIND_HOST=127.0.0.1
# Origin the Angular dev server (or deployed frontend) runs on. Used for CORS.
CLIENT_ORIGIN=http://localhost:6200

# ---- Admin auth ---------------------------------------------------------
# Secret used to sign/verify admin session tokens and download links. Required
# -- generate a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=
# How long a signed digital-download link stays valid.
DOWNLOAD_TOKEN_TTL=30d
# Email/password the admin panel accepts. ADMIN_PASSWORD_HASH is a bcrypt
# hash, not the raw password -- generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# ---- Stripe (checkout + booking deposits) --------------------------------
# From the Stripe dashboard. Leave blank to disable checkout/booking payments.
STRIPE_SECRET_KEY=
# From the Stripe CLI/dashboard webhook config; required for orders and
# bookings to actually confirm after payment.
STRIPE_WEBHOOK_SECRET=

# ---- Outbound email (contact form, order/booking confirmations) ---------
# Leave SMTP_HOST/SMTP_USER/SMTP_PASS blank to disable email sending; the
# site still works, it just won't send confirmation emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER / ADMIN_EMAIL respectively when unset.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# ---- Booking (Event Center date holds) -----------------------------------
# Minutes a Stripe checkout hold reserves a date before it releases.
BOOKING_HOLD_MINUTES=15
# Hours before a booking that a refund is still allowed.
BOOKING_REFUND_CUTOFF_HOURS=48

# ---- Print fulfilment (physical print orders) ----------------------------
# "manual" (default) queues prints for the admin to fulfil by hand. Set to a
# configured provider name once one is wired up in fairviewApi/fulfilment.js.
PRINT_PROVIDER=manual

# ---- Gallery media storage --------------------------------------------
# Where storage/media/* lives on disk. Defaults to <repo>/storage/media; only
# set this in production if media is mounted somewhere else.
MEDIA_DIR=
# Cloudflare R2 (recommended for production): media is served from this
# bucket over MEDIA_CDN_URL instead of local disk. Leave all four blank to
# serve media from local disk / the API instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL media is served from once R2 is configured, e.g.
# https://media.fairview-event-center.com (no trailing slash). Also written
# into src/assets/media-config.json by `npm run manifest` so the frontend
# knows where to fetch media from.
MEDIA_CDN_URL=
# Base URL of the deployed API, e.g. https://api.fairview-event-center.com.
# Only needed for a static frontend deploy with no same-origin API in front;
# leave blank for local dev (same-origin /api is proxied to the API).
API_BASE_URL=

# ---- Watermarking (scripts/watermark-media.js) ---------------------------
WATERMARK_TEXT=FAIRVIEW EVENT CENTER
# "corner" (default) or "tile".
WATERMARK_STYLE=corner

# ---- Google Drive (optional alternate media/delivery backend) -----------
# Only needed if using Google Drive instead of/alongside R2 for media
# storage or private digital-download delivery. Share one Drive folder with
# the service account's client_email, then put its folder ID and the
# service account JSON (as a single-line string) here.
GOOGLE_DRIVE_FOLDER_ID=
# Separate folder for private sale-photo delivery; defaults to
# GOOGLE_DRIVE_FOLDER_ID when unset.
GOOGLE_MEDIA_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# How long a signed Google Drive media link stays valid.
GOOGLE_MEDIA_TOKEN_TTL=12h

# ---- One-off migration scripts --------------------------------------
# Only used by scripts/migrate-uploads-to-drive.js; defaults to the repo's
# storage/uploads directory when unset.
UPLOADS_DIR=
